# ISB Backend URL (no trailing slash)
VITE_API_URL=https://your-backend.railway.app/api/v1

# Kiosk service account — one pair per physical device (bun run db:seed-kiosk)
# For local multi-device release, use per-device env files instead:
#   .env.prod-01.example → .env.prod-01
#   .env.prod-02.example → .env.prod-02
# Then: npm run release
#
# Single-device dev (.env):
VITE_KIOSK_USERNAME=kiosk_service
VITE_KIOSK_PASSWORD=028510

# APK filename for OTA updates (must match kiosk-release.json artifact for this device)
# VITE_KIOSK_APK_FILENAME=kiosk-prod-01.apk
