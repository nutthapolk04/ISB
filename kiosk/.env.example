# ISB Backend URL (no trailing slash)
VITE_API_URL=https://your-backend.railway.app/api/v1

# Kiosk service account username — one per physical device (bun run db:seed-kiosk).
# Password is entered on each boot in the app (stored in users table, not here).
# Device 1:
VITE_KIOSK_USERNAME=kiosk_service
# Device 2 example:
# VITE_KIOSK_USERNAME=kiosk_service_2

# Optional: default technician console password until changed on-device
# VITE_TECHNICIAN_PASSWORD=kiosk1234
