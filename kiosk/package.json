{
  "name": "kiosk-balance-app",
  "private": true,
  "version": "1.0.23",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-android-version.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview --port $PORT --host",
    "sync-android-version": "node scripts/sync-android-version.mjs",
    "release": "node scripts/build-release.mjs",
    "release:patch": "node scripts/build-release.mjs --bump patch",
    "release:minor": "node scripts/build-release.mjs --bump minor",
    "release:major": "node scripts/build-release.mjs --bump major",
    "test": "bun test tests"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "capacitor-hardware": "../plugins/capacitor-hardware",
    "lucide-vue-next": "^0.469.0",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.60.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vue-tsc": "^2.1.10"
  }
}
