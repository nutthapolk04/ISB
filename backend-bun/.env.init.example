# Environment for one-shot DB bootstrap: bun run prod:init
#
# Copy and fill in, then run from backend-bun/:
#   cp .env.init.example .env.init
#   bun --env-file=.env.init run prod:init
#
# Or merge these into .env / .env.prod and run:
#   bun --env-file=.env.prod run prod:init
#
# Flags (append after --):
#   --dry-run              migrate + seed + sync only; balance/spend-limit dry-run
#   --skip-sync            skip ISB JSON import
#   --skip-balance         skip wallet balance xlsx import
#   --skip-spendlimit      skip spend-limit xlsx import
#   --skip-spending-groups skip spending-groups.json seed
#
# Data files (not env — must exist under backend-bun/docs/):
#   docs/sync_data/departments_batch_001.json
#   docs/sync_data/families_batch_001.json … _003.json
#   docs/sync_data/staffs_batch_001.json … _002.json
#   docs/CustomerBalanceReportAsof16Jul2026-summary.xlsx
#   docs/spend-limit.xlsx
#   docs/spending-groups.json

# ── Required ────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Recommended (ISB sync — profile photo_url stored in DB) ─────────────────
# Public API origin (no trailing slash). Used when syncing students/staff/parents.
# ISB_PHOTO_DIR is NOT needed for init — only when serving photos at runtime.

BACKEND_BASE_URL=https://campuscard.isb.ac.th

# Legacy CDN URL — only if BACKEND_BASE_URL is unset (http/https only)
# ISB_PHOTO_BASE_URL=https://cdn.example.com/photos

# ── Admin accounts (step 2 — defaults shown) ────────────────────────────────

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_EMAIL=admin@isb-coop.local
ADMIN_FULL_NAME=System Admin

ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=admin1234
ADMIN2_EMAIL=admin2@isb-coop.local
ADMIN2_FULL_NAME=System Admin 2

# ── Kiosk service accounts (step 2 — must match kiosk/.env on each device) ─

KIOSK_SERVICE_USERNAME=kiosk_service
KIOSK_SERVICE_PASSWORD=kiosk1234
KIOSK_SERVICE_EMAIL=kiosk@isb-coop.local
KIOSK_SERVICE_FULL_NAME=Kiosk 1

KIOSK_SERVICE_2_USERNAME=kiosk_service_2
KIOSK_SERVICE_2_PASSWORD=kiosk1234
KIOSK_SERVICE_2_EMAIL=kiosk2@isb-coop.local
KIOSK_SERVICE_2_FULL_NAME=Kiosk 2

# ── Not used by prod:init (server runtime only) ───────────────────────────
# JWT_SECRET, CORS_ORIGINS, PORT, FRONTEND_BASE_URL, PYMT_*, APP_ENV,
# ISB_SYNC_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SMTP_*
